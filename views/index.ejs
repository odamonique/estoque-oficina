<%- include('partials/header', {
  title: 'Dashboard'
}) %>

<h1 class="mb-4">
  Dashboard
</h1>

<div class="card p-4">

  <h4>
    Bem-vindo, <%= user.nome %>
  </h4>

  <p>
    Cargo: <strong><%= user.cargo %></strong>
  </p>

</div>

<div class="row mt-4">

  <div class="col-md-4">

    <div class="card p-3">

      <h5>Fornecedores</h5>

      <a
        href="/fornecedores"
        class="btn btn-primary"
      >
        Acessar
      </a>

    </div>

  </div>

  <div class="col-md-4">

    <div class="card p-3">

      <h5>Peças</h5>

      <a
        href="/pecas"
        class="btn btn-primary"
      >
        Acessar
      </a>

    </div>

  </div>

  <% if (user.cargo === 'gerente') { %>

    <div class="col-md-4">

      <div class="card p-3">

        <h5>Usuários</h5>

        <a
          href="/usuarios"
          class="btn btn-primary"
        >
          Acessar
        </a>

      </div>

    </div>

  <% } %>

</div>

<%- include('partials/footer') %>