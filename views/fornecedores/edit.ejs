<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Fornecedor</title>
</head>
<body>
    <h1>Editar Fornecedor</h1>

    <form method="POST" action="/fornecedores/update/<%= fornecedor.id %>">

        <input type="text" name="razao_social" value="<%= fornecedor.razao_social %>">
        <br><br>

        <input type="text" name="nome_fantasia" value="<%= fornecedor.nome_fantasia %>">
        <br><br>

        <input type="text" name="cnpj" value="<%= fornecedor.cnpj %>">
        <br><br>

        <input type="text" name="endereco" value="<%= fornecedor.endereco %>">
        <br><br>

        <input type="text" name="telefone" value="<%= fornecedor.telefone %>">
        <br><br>

        <input type="email" name="email" value="<%= fornecedor.email %>">
        <br><br>

        <input type="text" name="nome_contato" value="<%= fornecedor.nome_contato %>">
        <br><br>

        <button type="submit">Atualizar</button>

    </form>

    <br>

    <a href="/fornecedores">Voltar</a>

</body>
</html>