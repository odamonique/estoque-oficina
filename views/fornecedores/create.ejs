<%- include('../partials/header', {
  title: 'Título'
}) %>

    <h1>Novo Fornecedor</h1>
    

    <form method="POST" action="/fornecedores">

        <input type="text" name="razao_social" placeholder="Razão Social" required>
        <br><br>

        <input type="text" name="nome_fantasia" placeholder="Nome Fantasia">
        <br><br>

        <input type="text" name="cnpj" placeholder="CNPJ" required>
        <br><br>

        <input type="text" name="endereco" placeholder="Endereço">
        <br><br>

        <input type="text" name="telefone" placeholder="Telefone" required>
        <br><br>

        <input type="email" name="email" placeholder="Email" required>
        <br><br>

        <input type="text" name="nome_contato" placeholder="Nome Contato" required>
        <br><br>

        <button type="submit">
            Salvar
        </button>

    </form>
    <br>
    <a href="/fornecedores">Voltar</a>

<%- include('../partials/footer') %>