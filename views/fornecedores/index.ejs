<%- include('../partials/header', {
  title: 'Título'
}) %>

    <a href="/fornecedores/novo"> Novo Fornecedor </a>
    <hr>
    <table border="1" cellpadding="10">
        <tr>
            <th>ID</th>
            <th>Razão Social</th>
            <th>Nome Fantasia</th>
            <th>CNPJ</th>
            <th>Endereço</th>
            <th>Telefone</th>
            <th>Email</th>
            <th>Nome para Contato</th>
            <th>Ações</th>>
        </tr>

        <% fornecedores.forEach(fornecedor => { %>
            <tr>
                <td><%= fornecedor.id %></td>
                <td><%= fornecedor.razao_social %></td>
                <td><%= fornecedor.nome_fantasia %></td>
                <td><%= fornecedor.cnpj %></td>
                <td><%= fornecedor.endereco %></td>
                <td><%= fornecedor.telefone %></td>
                <td><%= fornecedor.email %></td>
                <td><%= fornecedor.nome_contato %></td>

                <td>
                    <a href="/fornecedores/editar/<%= fornecedor.id %>">
                    Editar
                    </a>
                    <br>
                    <a href="/fornecedores/delete/<%= fornecedor.id %>">
                    Excluir
                    </a>
                </td>
            </tr>
        <% }) %>
    </table>
    <br>
    <a href="/">Voltar</a>

<%- include('../partials/footer') %>