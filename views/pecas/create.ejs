<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nova Peça</title>
</head>
<body>
    <h1>Nova Peça</h1>

    <form method="POST" action="/pecas">

        <input type="text" name="nome" placeholder="Nome" required>
        <br><br>

        <textarea name="descricao" placeholder="Descrição"></textarea>
        <br><br>

        <input type="text" name="marca" placeholder="Marca">
        <br><br>

        <input type="text" name="categoria" placeholder="Categoria">
        <br><br>

        <input type="number" name="quantidade" placeholder="Quantidade">
        <br><br>

        <input type="number" name="quantidade_minima" placeholder="Quantidade mínima">
        <br><br>

        <input type="number" step="0.01" name="preco_custo" placeholder="Preço custo">
        <br><br>

        <input type="number" step="0.01" name="preco_venda" placeholder="Preço venda">
        <br><br>

        <select name="fornecedor_id">

            <option value="">Selecione</option>

            <% fornecedores.forEach(fornecedor => { %>

            <option value="<%= fornecedor.id %>">
                <%= fornecedor.nome_fantasia %>
            </option>

            <% }) %>

        </select>

        <br><br>

        <button type="submit">Salvar</button>

    </form>

    <br>

    <a href="/pecas">Voltar</a>
    
</body>
</html>